{
  "name": "typescript-transform-lit-css",
  "description": "import CSS files as tagged template literals",
  "version": "3.0.2",
  "type": "module",
  "main": "typescript-transform-lit-css.js",
  "types": "typescript-transform-lit-css.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./typescript-transform-lit-css.d.ts",
        "default": "./typescript-transform-lit-css.js"
      },
      "require": {
        "types": "./typescript-transform-lit-css.d.cts",
        "default": "./typescript-transform-lit-css.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "author": "Benny Powers <web@bennypowers.com>",
  "license": "ISC",
  "scripts": {
    "build": "run-s build:esm build:runtime && node ../../build.js --cjs-types typescript-transform-lit-css",
    "build:esm": "tsc",
    "build:runtime": "node ../../build.js --runtime typescript-transform-lit-css"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bennypowers/lit-css.git",
    "directory": "packages/typescript-transform-lit-css"
  },
  "bugs": {
    "url": "https://github.com/bennypowers/lit-css/issues"
  },
  "keywords": [
    "typescript",
    "transform",
    "lit",
    "css",
    "webcomponents"
  ],
  "files": [
    "typescript-transform-lit-css.cjs",
    "typescript-transform-lit-css.js",
    "typescript-transform-lit-css.d.ts",
    "typescript-transform-lit-css.d.cts"
  ],
  "dependencies": {
    "@pwrs/lit-css": "^5.0.0"
  },
  "peerDependencies": {
    "clean-css": "^5",
    "postcss": "^8",
    "postcss-nesting": "^12 || ^13",
    "typescript": "^5",
    "ts-patch": "^3.0",
    "lit": "^2.7.2 || ^3.0.0"
  }
}
