{
  "name": "@pwrs/lit-css",
  "description": "Import CSS files as css tagged-template literals",
  "version": "5.0.0",
  "type": "module",
  "main": "lit-css.js",
  "types": "lit-css.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lit-css.d.ts",
        "default": "./lit-css.js"
      },
      "require": {
        "types": "./lit-css.d.cts",
        "default": "./lit-css.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "author": "Benny Powers",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bennypowers/lit-css.git",
    "directory": "packages/lit-css"
  },
  "bugs": {
    "url": "https://github.com/bennypowers/lit-css/issues"
  },
  "keywords": [
    "lit",
    "web-components",
    "css"
  ],
  "files": [
    "lit-css.cjs",
    "lit-css.js",
    "lit-css.d.ts",
    "lit-css.d.cts"
  ],
  "dependencies": {
    "cssnano": "^7.0.7"
  }
}
