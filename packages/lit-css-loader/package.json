{
  "name": "lit-css-loader",
  "description": "Import CSS files as tagged template literals",
  "version": "4.0.1",
  "type": "module",
  "main": "lit-css-loader.js",
  "types": "lit-css-loader.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lit-css-loader.d.ts",
        "default": "./lit-css-loader.js"
      },
      "require": {
        "types": "./lit-css-loader.d.cts",
        "default": "./lit-css-loader.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "author": "Benny Powers",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bennypowers/lit-css.git",
    "directory": "packages/lit-css-loader"
  },
  "bugs": {
    "url": "https://github.com/bennypowers/lit-css/issues"
  },
  "keywords": [
    "webpack",
    "loader",
    "webcomponents",
    "css",
    "lit"
  ],
  "files": [
    "lit-css-loader.cjs",
    "lit-css-loader.js",
    "lit-css-loader.d.ts",
    "lit-css-loader.d.cts"
  ],
  "dependencies": {
    "@pwrs/lit-css": "^4.0.0",
    "loader-utils": "^3.3.1"
  }
}
